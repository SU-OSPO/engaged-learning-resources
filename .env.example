# TeachOrange environment variables.
#
# Local dev:  copy to `.env` (gitignored) and adjust. Everything here has a safe
#             default for local work except the database connection.
# Production: set these in the server environment (CloudPanel site env / systemd
#             unit), NOT in a committed file.
#
# Lines marked SECRET must never be committed or shared.

# --- Core -------------------------------------------------------------------
# SECRET. Required when DJANGO_DEBUG=0 — the app refuses to start without it.
# Generate: python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
DJANGO_SECRET_KEY=

# 1/true/yes/on = debug on. MUST be 0 in production.
DJANGO_DEBUG=1

# Comma-separated. Production example: teachorange.com,www.teachorange.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, scheme required. Production: https://teachorange.com,https://www.teachorange.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Database ---------------------------------------------------------------
# Either set DATABASE_URL (wins if present) ...
# DATABASE_URL=postgres://user:password@localhost:5432/teaching_activities

# ... or the discrete settings below.
POSTGRES_DB=teaching_activities
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email ------------------------------------------------------------------
# With DEBUG=0 and no SMTP host/user configured, the backend falls back to
# console, and password reset + the contact form return HTTP 503 while the rest
# of the site looks healthy. Set these for production.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_DEFAULT_FROM_EMAIL=TeachOrange <noreply@teachorange.com>

# Where the public contact form delivers. Set this so the address is not hardcoded.
DJANGO_CONTACT_EMAIL=

# Overrides the automatic backend choice above. Rarely needed.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
